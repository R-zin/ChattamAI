# ---- Embeddings (OpenAI) ----
# Required: get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: override the embedding model / proxy
# OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- LLM (Anthropic Claude) ----
# This project uses a local Claude proxy; the SDK reads these automatically.
ANTHROPIC_BASE_URL=http://127.0.0.1:8082
ANTHROPIC_AUTH_TOKEN=freecc
# Model served by your proxy (override if different)
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_MAX_TOKENS=2048

# ---- Data / retrieval ----
# Drop Kerala Building Rules PDFs/txt here (or set an absolute path).
# Tip: `python -m scripts.fetch_kbr --url <URL>` downloads rules into this dir.
KBR_DATA_DIR=./data/kbr
INDEX_DIR=./data/index
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
# Minimum cosine-similarity for a retrieved rule chunk to be used (higher=better).
# 0.0 keeps everything (off); raise it (e.g. 0.2) to drop weak matches.
MIN_SCORE=0.0

# ---- Latency / cost caches (in-process, no external store) ----
# Query-embedding cache (wraps the embedding provider).
EMBEDDING_CACHE_ENABLED=1      # 1/on to enable, 0/off to disable
EMBEDDING_CACHE_TTL=300        # seconds a cached embedding lives
EMBEDDING_CACHE_MAXSIZE=1024   # max cached query embeddings
# Analyze-step memo (skips the analysis LLM on an identical re-check).
ANALYSIS_CACHE_TTL=300         # seconds a memoized analysis lives
ANALYSIS_CACHE_MAXSIZE=512     # max memoized analyses
# Max texts per embeddings.create call (large ingests are split into batches).
EMBEDDING_BATCH_SIZE=128

# ---- LLM plumbing ----
LLM_TIMEOUT=60                 # per-request timeout (seconds) for the Claude SDK
LLM_MAX_RETRIES=2              # retry budget for failed LLM/embedding requests

# ---- Auth (JWT; opt-in, OFF by default) ----
# Override in production — the default is an insecure dev value.
SECRET_KEY=chattamai-insecure-dev-secret-change-me
AUTH_ALGORITHM=HS256           # JWT signing algorithm
# Access-token TTL (seconds); also the session timeout for the DB layer.
TIME_OUT=3600
# If set, POST /auth/register requires a matching X-Admin-Key header.
# ADMIN_KEY=
# Opt-in protection: when truthy, mutating/paid routes (/api/ingest,
# /api/check) require a valid bearer token. Leave unset/empty to keep the
# credential-less smoke test on /api/health passing.
# AUTH_REQUIRED=
# SQLAlchemy connection string for the auth/user store (defaults to SQLite).
DATABASE_URL=sqlite:///./chattamai.db
