# Base URL of the FastAPI backend (no trailing slash).
# Leave EMPTY to call the same origin that served the app. That is correct for
# the Docker/Azure build (API + SPA in one container) and for `npm run dev`,
# where Vite proxies /api and /auth to http://127.0.0.1:8000
# (override with VITE_DEV_BACKEND).
# Set it only when the API lives on a different origin, e.g. https://api.example.com
VITE_API_URL=

# Set to true for a standalone demo with built-in mock data and NO backend
# (e.g. a public Vercel preview). Never set this on a real deployment: the app
# then shows fake results instead of calling the API.
VITE_USE_MOCKS=
